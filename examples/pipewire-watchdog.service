# Systemd service to monitor PipeWire and automatically recover audio.
# Copy to ~/.config/systemd/user/pipewire-watchdog.service
#
# IMPORTANT (v2): no Requires=pipewire.service and no ExecStartPre sleep.
# With Requires=, every pipewire restart (including the watchdog's own
# recovery!) stopped the watchdog, wiped its failure counter, and put it
# back into a blind startup window. The watchdog must outlive the thing
# it watches. The script does its own readiness wait.

[Unit]
Description=PipeWire Audio Watchdog
After=pipewire.service wireplumber.service pipewire-combined.service

[Service]
Type=simple
ExecStart=%h/.local/bin/pipewire-watchdog
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
